{
  "name": "agentoffice",
  "version": "0.1.0",
  "private": true,
  "description": "Private, local-only pixel-art office that visualises Claude, Codex and ChatGPT agent sessions.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node --watch server/index.ts",
    "build": "vite build",
    "start": "vite build && node server/index.ts",
    "serve": "node server/index.ts",
    "check": "tsc -p tsconfig.json",
    "snapshot": "node server/index.ts --once"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
