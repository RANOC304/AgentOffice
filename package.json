{
  "name": "agentoffice",
  "version": "0.1.0",
  "private": true,
  "description": "Private, local-only 3D office that shows your Claude, Codex and ChatGPT agent sessions, with missions you can launch from it.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node --disable-warning=ExperimentalWarning --watch server/index.ts",
    "build": "vite build",
    "start": "vite build && node --disable-warning=ExperimentalWarning server/index.ts",
    "serve": "node --disable-warning=ExperimentalWarning server/index.ts",
    "check": "tsc -p tsconfig.json",
    "snapshot": "node --disable-warning=ExperimentalWarning server/index.ts --once",
    "peer": "node --disable-warning=ExperimentalWarning server/peer.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
